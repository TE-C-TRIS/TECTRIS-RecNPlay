{
  "name": "tectris-web",
  "private": true,
  "version": "2.0.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace backend\" \"npm:dev --workspace frontend\"",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.2" }
}
